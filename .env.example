# PathFinder local development
# Copy to .env.local at the repo root and adjust if needed. Never commit .env.local.
# Do not create a repo-root .env file — local secrets belong in .env.local only.

# PostgreSQL (docker-compose maps host 5433 -> container 5432)
DATABASE_URL=postgresql+psycopg2://pathfinder:pathfinder@localhost:5433/pathfinder

API_HOST=0.0.0.0
# API bind port when using a process manager; uvicorn --port also works.
API_PORT=8000

# Comma-separated browser origins for CORS (match your frontend URL/port)
PATHFINDER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002

# Frontend (set in frontend/.env.local for Next.js builds)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Grounded explanation layer (optional). Path, assessment, and adaptation never wait on this.
PATHFINDER_AI_PROVIDER=stub
PATHFINDER_AI_MODEL=gpt-4o-mini
PATHFINDER_AI_API_KEY=
PATHFINDER_AI_BASE_URL=https://api.openai.com/v1
PATHFINDER_AI_TIMEOUT_SECONDS=8
# Groq (OpenAI-compatible):
# PATHFINDER_AI_PROVIDER=openai
# PATHFINDER_AI_BASE_URL=https://api.groq.com/openai/v1
# PATHFINDER_AI_MODEL=llama-3.3-70b-versatile
# PATHFINDER_AI_TIMEOUT_SECONDS=15

# Semantic relevance (local embeddings via fastembed; optional). Recommendation weight stays at 5%.
PATHFINDER_SEMANTIC_ENABLED=true
PATHFINDER_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Browser QA scripts (optional overrides)
# PF_BASE_URL=http://127.0.0.1:3002
# PF_API_URL=http://127.0.0.1:8000
